<div id="{{ entry.key }}">
  <b>{{ entry.title }}</b>&nbsp;
  {% if entry.pdf %}
    <a href="{{ entry.pdf }}" 
       target="_blank" 
       rel="noopener"
       style="color: inherit; 
              text-decoration: none;
              transition: color 0.2s ease;"
       onmouseover="this.style.color='var(--global-theme-color)'"
       onmouseout="this.style.color='inherit'">
       [PDF]
    </a>
  {% endif %}
  <br>
  {% assign authors = entry.author_array %}
  {% assign author_count = authors | size %}
  {% for author in authors %}
    {% if author.last and author.first %}
      {{ author.last }}, {{ author.first | slice: 0 | upcase }}.{% unless forloop.last %}{% if forloop.rindex0 == 1 %} and{% else %},{% endif %}{% endunless %}
    {% elsif author.last %}
      {{ author.last }}{% unless forloop.last %}{% if forloop.rindex0 == 1 %} and{% else %},{% endif %}{% endunless %}
    {% else %}
      {{ author }}{% unless forloop.last %}{% if forloop.rindex0 == 1 %} and{% else %},{% endif %}{% endunless %}
    {% endif %}
  {% endfor %},
  {% if entry.year %}{{ entry.year }},{% endif %}
  {% if entry.journal %}<i>{{ entry.journal }}</i>.{% endif %}
  {% if entry.booktitle %}<i>{{ entry.booktitle }}</i>.{% endif %}
</div>
