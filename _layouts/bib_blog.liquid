<li id="{{ entry.key }}" style="margin-bottom: 1.5em;">
  {% unless entry.key %}
    {% continue %}
  {% endunless %}

  <b>{{ entry.title }}</b>
  {% if entry.pdf %}
    <a href="{{ entry.pdf }}" target="_blank" rel="noopener">[PDF]</a>
  {% endif %}
  <br>
  <div style="margin: 0.3em 0 0.5em 0;">
    {% assign authors = entry.author_array %}
    {% assign author_count = authors | size %}
    {% for author in authors %}
      {% if author.last and author.first %}
        {{ author.last }} {{ author.first | slice: 0 | upcase }}.
      {% elsif author.last %}
        {{ author.last }}
      {% else %}
        {{ author }}
      {% endif %}
      {% if forloop.last == false %}
        {% if forloop.rindex0 == 1 %} and {% else %}, {% endif %}
      {% endif %}
    {% endfor %}
  </div>

  {% if entry.journal %}<i>{{ entry.journal }}</i>,{% endif %}
  {% if entry.booktitle %}<i>{{ entry.booktitle }}</i>,{% endif %}
  {% if entry.year %}{{ entry.year }}.{% endif %}
  {% if entry.note %}{{ entry.note }}.{% endif %}
</li>
