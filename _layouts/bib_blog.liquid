<li id="{{ entry.key }}">
  {% assign authors = entry.author %}
  {% for author in authors %}
    {% assign first = author.first | join: " " %}
    {% assign last = author.last | join: " " %}
    {{ first }} {{ last }}{% if forloop.last == false %}, {% endif %}
  {% endfor %},
  “<em>{{ entry.title }}</em>,”
  {% if entry.journal %} {{ entry.journal }},{% endif %}
  {% if entry.booktitle %} {{ entry.booktitle }},{% endif %}
  {% if entry.year %} {{ entry.year }}.{% endif %}
  {% if entry.pdf %}
    <a href="{{ entry.pdf }}" target="_blank" rel="noopener">[pdf]</a>
  {% endif %}
</li>
